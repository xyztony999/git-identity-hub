{
  // Copy to wrangler.jsonc for local deploy, OR set WRANGLER_* Builds env vars
  // and run `npm run deploy` (scripts/prepare-wrangler.mjs writes wrangler.jsonc).
  // Do not commit a filled wrangler.jsonc to a public repo.
  // Worker Secrets (Dashboard / `wrangler secret put`, not this file):
  //   VAPID_PRIVATE_KEY, CF_API_TOKEN (Email Routing Addresses:Read), CF_ACCOUNT_ID
  // Deploy guide: docs/deploy.md
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "git-identity-hub",
  "main": "src/index.ts",
  "build": {
    "command": "npm run build:client"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "git-identity-hub",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG",
      "id": "YOUR_KV_CONFIG_NAMESPACE_ID"
    },
    {
      "binding": "MAIL",
      "id": "YOUR_KV_MAIL_NAMESPACE_ID"
    }
  ],
  "vars": {
    "PUBLIC_MAILBOX": "git@example.com",
    "IDENTITY_NAME": "Your Name",
    "VAPID_PUBLIC_KEY": "YOUR_VAPID_PUBLIC_KEY",
    "VAPID_SUBJECT": "mailto:you@example.com"
  }
}
